# ==============================================================================
# Owostack API — secrets template
#
# Local dev:   cp .env.example .env         (wrangler dev reads .env; it is gitignored)
# Deployed:    pnpm exec wrangler secret put <NAME> --env test    → sandbox.owostack.com
#              pnpm exec wrangler secret put <NAME> --env live    → api.owostack.com
#
# Non-secret vars (ENVIRONMENT, ENABLED_PROVIDERS, BETTER_AUTH_URL, DASHBOARD_URL,
# USE_EVENTS_PIPELINE) and all bindings (DB, DB_AUTH, KV, DOs, queues, workflows)
# live in wrangler.jsonc per environment — do not put them here.
# ==============================================================================

# ---- Core (required on every worker) -----------------------------------------
# 32 random bytes, base64. Encrypts provider secret keys at rest. Never rotate
# without re-encrypting provider_accounts — existing rows become unreadable.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Better Auth session signing secret.  openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- OAuth (optional; login falls back to email if unset) ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=

# ---- Cloudflare analytics / events pipeline (optional) -----------------------
CF_ACCOUNT_ID=
CF_ANALYTICS_READ_TOKEN=          # API token with Analytics:Read
ANALYTICS_DATASET=                # optional override of the Analytics Engine dataset
R2_SQL_TOKEN=                     # only when USE_EVENTS_PIPELINE=true
R2_WAREHOUSE=                     # R2 Data Catalog warehouse id

# ---- Owostack-managed sandbox providers (--env test ONLY) --------------------
# One secret per provider so each rotates independently. Bindings are discovered
# by the MANAGED_SANDBOX_ prefix; delete a line to stop managing that provider.
# Value: the bare secret key, or a JSON object when the provider needs more than
# one credential (secretKey is required). See src/lib/managed-sandbox.ts.
#
# Never set these on --env live; they are ignored there anyway.
#
# Register this webhook URL on EACH provider's TEST account (all events):
#   Paystack       https://sandbox.owostack.com/webhooks/sandbox/paystack
#   Stripe         https://sandbox.owostack.com/webhooks/sandbox/stripe
#   Dodo Payments  https://sandbox.owostack.com/webhooks/sandbox/dodopayments
#   Bachs          https://sandbox.owostack.com/webhooks/sandbox/bachs
# Paystack verifies with the secret key itself; the others need the webhook
# signing secret the provider shows you when you save that URL.

MANAGED_SANDBOX_PAYSTACK=sk_test_
MANAGED_SANDBOX_STRIPE={"secretKey":"sk_test_","publishableKey":"pk_test_","webhookSecret":"whsec_"}
MANAGED_SANDBOX_DODOPAYMENTS={"secretKey":"","webhookSecret":""}
MANAGED_SANDBOX_BACHS={"secretKey":"sk_sandbox_","webhookSecret":""}
# MANAGED_SANDBOX_POLAR={"secretKey":"polar_oat_","webhookSecret":""}   # registered adapter, not in ENABLED_PROVIDERS by default

# ---- Legacy (declared in Env, no longer read by any code path) ---------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
