{
  "name": "owostack-dashboard",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest --run",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "wrangler pages deploy .svelte-kit/cloudflare"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.2",
    "@better-auth/infra": "^0.2.1",
    "@better-auth/sso": "^1.6.2",
    "@owostack/types": "workspace:*",
    "better-auth": "^1.6.2",
    "better-call": "1.3.5",
    "better-result": "^2.7.0",
    "chart.js": "^4.4.7",
    "phosphor-svelte": "^3.1.0",
    "svelte-sonner": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@sveltejs/adapter-cloudflare": "^6.0.0",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "svelte": "^5.48.2",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.0.5",
    "wrangler": "^4.62.0"
  }
}
